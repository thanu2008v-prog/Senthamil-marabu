#!/usr/bin/env bash
# செந்தமிழ் மரபு களஞ்சியம் — தேவையற்ற கோப்புகளை நீக்குதல் (அடுத்த பகிர்வுக்கு முன்)
#
# பயன்பாடு (களஞ்சியத்தின் வேர் அடைவில்):
#   bash 07_களஞ்சியத்_தூய்மை.sh          # பார்வை மட்டும்: எதுவும் மாறாது
#   bash 07_களஞ்சியத்_தூய்மை.sh --seyal  # நகர்த்தல் + நீக்கல் (commit, push நீங்களே செய்யுங்கள்)
#
# செய்வது:
#   1. பயனுள்ள மூன்று கோப்புகளைச் சரியான இடத்துக்கு நகர்த்தும்:
#        gh  → scripts/set_doi.py
#        fdst → scripts/fetch_doi.py   (fedt, ffg — அதே உள்ளடக்கம்)
#        st  → docs/RELEASE_v1.0.0.md  (note — முந்தைய வடிவு)
#   2. மேல்மட்டத்தில் உள்ள, வைக்கும் பட்டியலில் இல்லாத எல்லாக் கோப்புகளையும் நீக்கும்
#      (பெரும்பாலும் இணையப் பக்கத்தில் கட்டளையைக் கோப்புப் பெயராக ஒட்டியதால் உருவானவை).
#   3. பெயர்க் கூறு 100 எழுத்தைத் தாண்டும் எல்லாக் கோப்புகளையும் நீக்கும்
#      (இவற்றால் பலர் களஞ்சியத்தைப் பதிவிறக்க முடிவதில்லை).
#   4. KEEP_DIRS பட்டியலில் இல்லாத மேல்மட்ட அடைவுகளை நீக்கும்
#      ("python3 scripts", "Concept DOI: 10.5281", "# CI நிலை …" — கட்டளைகளால் உருவானவை).
#   5. CRLF-உடன் சேமிக்கப்பட்ட ai_console.py, senthamil_app.py-ஐ LF ஆக்கும்.
#
# வைக்கப்படுபவை: KEEP_DIRS அடைவுகள், KEEP மேல்மட்டக் கோப்புகள்.
# hfst-3.12.2.4b0.tar.gz வைக்கப்படுகிறது — .github/workflows மூன்றும் அதைச் சுட்டுகின்றன.
#
# © 2026 தனுசாந்தன் வர்ணகுலசிங்கம் — தமிழுக்கும் உருவாக்கியவருக்குமான உரிமை; தொழில்நுட்ப உதவி: Claude (Anthropic).

set -euo pipefail
APPLY=0; [[ "${1:-}" == "--seyal" ]] && APPLY=1

git rev-parse --is-inside-work-tree >/dev/null
[[ -f CITATION.cff && -d senthamil_marabu ]] || { echo "களஞ்சிய வேரில் இயக்குங்கள்"; exit 1; }

python3 - "$APPLY" <<'PY'
import subprocess, sys, os
apply = sys.argv[1] == "1"
KEEP = {
    ".gitattributes", ".gitignore", ".zenodo.json", "CHANGES.md", "CITATION.cff",
    "CONTRIBUTING.md", "LICENSE.md", "Makefile", "README.md", "ai_console.py",
    "datapackage.json", "index.html", "install_tamil_font.bat", "install_tamil_font.ps1",
    "pyproject.toml", "requirements.txt", "run_aakkam.bat", "run_ai.bat",
    "senthamil_app.py", "hfst-3.12.2.4b0.tar.gz",
}
KEEP_DIRS = {
    ".github", "alavai", "app", "book", "data", "data_v2", "docs", "examples", "fonts",
    "karuvi", "kuriyaakkam", "orunguri", "pirankol", "pothu", "punarchi", "rules",
    "schema", "scripts", "senthamil_marabu", "seyali", "sources", "tests", "urai_kit",
}
MOVE = {"gh": "scripts/set_doi.py", "fdst": "scripts/fetch_doi.py", "st": "docs/RELEASE_v1.0.0.md"}

# HEAD-இலிருந்து எடுக்கிறோம்: நீண்ட பெயர்க் கோப்புகள் பதிவிறக்கத்தில் இறங்காமல் index-இல் இல்லாமல் இருக்கலாம்
out = subprocess.run(["git", "ls-tree", "-r", "-z", "--name-only", "HEAD"], capture_output=True, check=True).stdout
files = [f.decode() for f in out.split(b"\0") if f]

remove = []
for f in files:
    parts = f.split("/")
    if f in MOVE:
        continue
    if (any(len(p) > 100 for p in parts)
            or (len(parts) == 1 and f not in KEEP)
            or (len(parts) > 1 and parts[0] not in KEEP_DIRS)):
        remove.append(f)

print(f"நகர்த்தல்: {len(MOVE)}")
for a, b in MOVE.items():
    print(f"  {a!r} → {b}")
print(f"நீக்கல்: {len(remove)}")
for f in remove:
    print("  ", repr(f[:70] + ("…" if len(f) > 70 else "")))

if not apply:
    print("\nபார்வை மட்டும். செயல்படுத்த: --seyal")
    sys.exit(0)

for a, b in MOVE.items():
    if a in files:
        subprocess.run(["git", "mv", "-k", "--", a, b], check=True)
# நீண்ட பெயர்க் கோப்புகள் வட்டில் இல்லாமல் இருக்கலாம்; ஆகவே --cached உடன் நீக்கி, இருப்பவற்றை வட்டிலிருந்தும் நீக்கல்
for f in remove:
    subprocess.run(["git", "rm", "-q", "--cached", "--ignore-unmatch", "--", f], check=True)
    try:
        os.remove(f)
    except (FileNotFoundError, OSError):
        pass
# CRLF வரி முடிவுடன் சேமிக்கப்பட்ட இரண்டு .py கோப்புகள் (.gitattributes: *.py eol=lf) —
# இல்லையெனில் ஒவ்வொரு புதிய பதிவிறக்கத்திலும் "மாற்றப்பட்டவை" எனத் தோன்றும்
subprocess.run(["git", "add", "--renormalize", "--", "ai_console.py", "senthamil_app.py"], check=True)
print("\nமுடிந்தது. சரிபார்த்து: make check && git commit -m 'களஞ்சியத் தூய்மை' && git push")
PY

