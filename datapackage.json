     },
     {
      "name": "sutra",
      "type": "integer",
      "description": "ஓத்துக்குள் சூத்திர எண்"
     },
     {
      "name": "moolam",
      "type": "string",
      "description": "சூத்திர மூலம், மாற்றமின்றி; அடிகள் «\\n» ஆல் பிரிக்கப்பட்டவை"
     },
     {
      "name": "kaandigai_porul",
      "type": "string",
      "description": "காண்டிகை — சூத்திரப் பொருள்"
     },
     {
      "name": "kaandigai_ethu",
      "type": "string",
      "description": "ஏது நடை (முன்–பின் தொடர்பு, காரணம்), நூலுள் எடுத்துக்காட்டோடு"
     },
     {
      "name": "urai",
      "type": "string",
      "description": "உரை: இயைபு, மறுதலைக் கடாஅ முதலியன. «(645)», «(649)», «(650)» என்ற குறிகள் உரையின் எந்தக் கூறு என்பதைச் சுட்டுகின்றன; «ஆய்வு N» நூலின் «ஆய்வுகள்» பிற்சேர்க்கை எண்"
     },
     {
      "name": "vagai",
      "type": "string",
      "description": "விதி / விலக்கு / விதி-விலக்கு"
     },
     {
      "name": "utthi",
      "type": "string",
      "description": "{peyar, saanru}: சூத்திரச் சொல்லில் அடையாளம் உள்ள உத்தியும் அச்சொல்லும்; அடையாளம் இல்லாத உத்திகள் குறிக்கப்படுவதில்லை"
     },
     {
      "name": "thunivu",
      "type": "string",
      "description": "ஒரே துணிவு — நிலையும் தீராத கூறும்"
     },
     {
      "name": "nilai",
      "type": "string",
      "description": "துணிவின் நிலை: நூலில் நேரடியாக / ஒருதலை அன்மை / நூலில் இல்லை"
     }
    ],
    "primaryKey": "id"
