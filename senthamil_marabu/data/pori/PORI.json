   "sutra": [
    "எழு. 296",
    "எழு. 297",
    "எழு. 298",
    "எழு. 306",
    "எழு. 327",
    "எழு. 376",
    "எழு. 401"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "ஞ, ந ஈறும் தொழிற்பெயர் ஈறும் — வல்லினமோ ஞ, ந, ம, வவோ வர உகரம் வரும்"
  },
  {
