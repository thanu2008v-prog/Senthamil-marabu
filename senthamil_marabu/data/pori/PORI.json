   "id": "299",
   "kopu": "pori/19_299.att",
   "sutra": [
    "எழு. 299"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "நகர ஈறு வேற்றுமையில் உகரம் கெட்டு அகரம்"
  },
  {
