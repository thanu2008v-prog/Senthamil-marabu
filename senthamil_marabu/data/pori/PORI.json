   "kattayam": true,
   "vilakkam": "ண, ள முன் த, ந — ட, ண ஆகும்"
  },
  {
   "varisai": 22,
   "id": "149",
   "kopu": "pori/22_149.att",
   "sutra": [
    "எழு. 149"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "ல, ன முன் த, ந — ற, ன ஆகும்"
