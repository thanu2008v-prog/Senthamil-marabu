   "sutra": [
    "எழு. 411",
    "எழு. 414"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "குற்றியலுகர ஈறு — வேற்றுமையில் வந்த வல்லெழுத்து மிகும்"
