   "sutra": [
    "எழு. 310"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "மகர ஈறு — வேற்றுமையில் மகரம் கெட்டு வல்லெழுத்து மிகும்"
  },
