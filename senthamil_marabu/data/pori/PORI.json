   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "வல்லின மெய்யின் மேல் இறுதி உகரம் குறுகும்"
  },
  {
   "varisai": 1,
   "id": "267",
   "kopu": "pori/01_267.att",
   "sutra": [
    "எழு. 267"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "குறிலை அடுத்த ஈரெழுத்துச் சொல்லில் உகரம் குறுகாது"
  },
  {
   "varisai": 2,
   "id": "411",
   "kopu": "pori/02_411.att",
   "sutra": [
    "எழு. 411"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": false,
   "vilakkam": "ஈரெழுத்து, உயிர்த்தொடர் குற்றியலுகரம் — வேற்றுமையாயின் ஒற்றிடை இனமிகும்"
  },
  {
   "varisai": 3,
   "id": "414ஆ",
   "kopu": "pori/03_414ஆ.att",
   "sutra": [
    "எழு. 414"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "மென்றொடர் குற்றியலுகரம் — வேற்றுமையில் மெல்லொற்று வல்லொற்றாகும்"
  },
  {
   "varisai": 4,
   "id": "410",
   "kopu": "pori/04_410.att",
   "sutra": [
    "எழு. 410"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "யகரம் வர குற்றியலுகரம் இகரமாகக் குறுகும்"
  },
  {
   "varisai": 5,
   "id": "105",
   "kopu": "pori/05_105.att",
   "sutra": [
    "எழு. 105",
    "எழு. 138"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "குற்றியலுகர ஈறு மெய்யீறு போல் நிற்க, வரும் உயிர் மெய்யோடு சேரும்"
  },
  {
   "varisai": 6,
   "id": "207",
   "kopu": "pori/06_207.att",
   "sutra": [
    "எழு. 206",
    "எழு. 207"
   ],
   "nilai": "ஒருதலை அன்மை",
   "kattayam": true,
   "vilakkam": "சுட்டின் முன் உயிர் வர வகர ஒற்று"
  },
  {
   "varisai": 7,
   "id": "206",
   "kopu": "pori/07_206.att",
   "sutra": [
    "எழு. 206"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "சுட்டின் முன் ய, வ வர வகர ஒற்று"
  },
  {
   "varisai": 8,
   "id": "205",
   "kopu": "pori/08_205.att",
   "sutra": [
    "எழு. 205"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "சுட்டின் முன் ஞ, ந, ம வர அவ்வொற்று மிகும்"
  },
  {
   "varisai": 9,
   "id": "204",
   "kopu": "pori/09_204.att",
   "sutra": [
    "எழு. 204",
    "எழு. 236"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "சுட்டின் முன்னும் வினையெச்சத்தின் முன்னும் வல்லெழுத்து மிகும்"
  },
  {
   "varisai": 10,
   "id": "222",
   "kopu": "pori/10_222.att",
   "sutra": [
    "எழு. 222"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "«செய்யா» வினையெச்சத்தின் முன்னும் வல்லெழுத்து மிகும்"
  },
  {
   "varisai": 11,
   "id": "160",
   "kopu": "pori/11_160.att",
   "sutra": [
    "எழு. 160"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "குறிலை அடுத்த ஒற்று, உயிர் வர இரட்டும் (தன்னுரு இரட்டல்)"
  },
  {
   "varisai": 12,
   "id": "140",
   "kopu": "pori/12_140.att",
   "sutra": [
    "எழு. 140"
   ],
   "nilai": "ஒருதலை அன்மை",
   "kattayam": false,
   "vilakkam": "உயிர் முன் உயிர் வர உடம்படுமெய் (ய், வ்)"
  },
  {
   "varisai": 13,
   "id": "217",
   "kopu": "pori/13_217.att",
   "sutra": [
    "எழு. 217"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "அகர ஈற்று மரப்பெயர் முன் வல்லினம் வர இன மெல்லெழுத்து மிகும்"
  },
  {
   "varisai": 14,
   "id": "203",
   "kopu": "pori/14_203.att",
   "sutra": [
    "எழு. 203",
    "எழு. 221",
    "எழு. 249",
    "எழு. 254",
    "எழு. 264",
    "எழு. 274",
    "எழு. 289"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "அகர ஈற்றுப் பெயரும், அதன் இயல்பின ஆ, ஈ, உ, ஊ, ஏ, ஓ ஈறுகளும் — அல்வழியில் வல்லினம் வர அவ்வொற்று மிகும்"
  },
  {
   "varisai": 15,
   "id": "235",
   "kopu": "pori/15_235.att",
   "sutra": [
    "எழு. 235",
    "எழு. 280"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "இகர, ஐகார ஈற்றுப் பெயர் — வேற்றுமையில் வல்லினம் வர அவ்வொற்று மிகும்"
  },
  {
   "varisai": 16,
   "id": "158",
   "kopu": "pori/16_158.att",
   "sutra": [
    "எழு. 158"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": false,
   "vilakkam": "இகர, ஐகார ஈற்றுப் பெயர் — அல்வழியில் இயல்பு, மிகுதல், உறழ்தல் மூன்றும் உள; சொல்லைப் பொறுத்தது"
  },
  {
   "varisai": 17,
   "id": "216",
   "kopu": "pori/17_216.att",
   "sutra": [
    "எழு. 216",
    "எழு. 225",
    "எழு. 252",
    "எழு. 259",
    "எழு. 266",
    "எழு. 276",
    "எழு. 292"
   ],
   "nilai": "ஒருதலை அன்மை",
   "kattayam": false,
   "vilakkam": "அ, ஆ, ஈ, உ, ஊ, ஏ, ஓ ஈற்றுப் பெயர் — வேற்றுமையிலும் «அதனோரற்றே»; சுட்டுவது எது என நூல் பெயரிடாததால் விருப்பாக"
  },
  {
