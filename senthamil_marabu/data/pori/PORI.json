   "sutra": [
    "எழு. 413"
   ],
   "nilai": "ஒருதலை அன்மை",
   "kattayam": true,
   "vilakkam": "இடையொற்று, ஆய்தத் தொடர் — «நடைஆ இயல»: வல்லெழுத்து மிகுதல் (எந்நடை என நூல் சுட்டவில்லை)"
  },
  {
