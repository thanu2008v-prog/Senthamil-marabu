    "எழு. 302",
    "எழு. 396"
   ],
   "nilai": "நூலில் நேரடியாக",
   "kattayam": true,
   "vilakkam": "ண, ள ஈறு — வேற்றுமையில் வல்லினம் வர டகரம்"
