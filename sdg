name: build-nool

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 1 }

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: |
          python3 -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install "PyYAML>=6.0" "lxml>=5.0"

      - name: Check SQLite has FTS5 + trigram
        run: |
          python3 - <<'PY'
          import sqlite3, sys
          print("sqlite:", sqlite3.sqlite_version)
          if sqlite3.sqlite_version_info < (3, 34): sys.exit("FTS5 trigram needs SQLite >= 3.34")
          c = sqlite3.connect(":memory:")
          try: c.execute("CREATE VIRTUAL TABLE t USING fts5(x, tokenize='trigram')")
          except sqlite3.OperationalError as e: sys.exit(f"FTS5 trigram unavailable: {e}")
          print("FTS5 trigram OK")
          PY

      - name: Build v2 (bundle + db + csv + yaml)
        run: python3 scripts/build_v2.py

      - name: Build human-readable nūl + round-trip
        run: python3 scripts/build_nool.py

      - name: Verify against the nūl's own rules
        run: python3 scripts/check_nool.py

      - name: Build single-file edition
        run: |
          python3 scripts/build_single_file.py --dry | tee build/dry.log
          python3 scripts/build_single_file.py --sha | tee build/sha.log
          python3 scripts/build_single_file.py       | tee build/build.log
          cat build/sha.log

      - name: Build TEI P5 projection
        run: python3 scripts/build_tei.py

      - name: Validate TEI (non-blocking)
        continue-on-error: true
        run: python3 scripts/build_tei.py --validate

      - name: Sanity-check 1602
        run: |
          f=build/SENTHAMIL_MARABU.md
          n=$(grep -c '^### \(ezhu\|sol\|porul\)\.' "$f")
          echo "sutra headings: $n"
          [ "$n" -eq 1602 ] || { echo "expected 1602, got $n"; exit 1; }

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: nool-build
          path: |
            build/SENTHAMIL_MARABU.md
            build/SENTHAMIL_MARABU.tei.xml
            build/bundle_v2.json
            build/senthamil_v2.db
            build/sutras_v2.csv
            build/senthamil_marabu.md
            build/urai_kit/
            build/sha.log
            build/dry.log
            build/build.log
          if-no-files-found: error
          retention-days: 30

      - name: Upload single file
        uses: actions/upload-artifact@v4
        with:
          name: SENTHAMIL_MARABU
          path: build/SENTHAMIL_MARABU.md
          retention-days: 90

      - name: Attach to release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: |
            build/SENTHAMIL_MARABU.md
            build/SENTHAMIL_MARABU.tei.xml
            build/sha.log
            .zenodo.json
            CITATION.cff
          generate_release_notes: true
          body_path: .github/RELEASE_NOTE.md
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}